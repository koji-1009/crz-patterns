---
interface Props {
  variant: "wide" | "narrow";
}
const { variant } = Astro.props;
const links = ["Link A", "Link B", "Link C"];
---

<!-- Both previews sit on one page, both positioned. Without the :has() z-index
     the later one wins on tree order and paints over the earlier one's open
     dropdown. `demo-container`, `hamburger` and `dropdown` are test hooks. -->
<div
  class:list={[
    "demo-container @container relative border border-border rounded-md has-[.hamburger[open]]:z-1",
    variant,
    variant === "wide" ? "w-full" : "w-[375px] max-w-full",
  ]}
>
  <nav class="flex items-center gap-4 py-3 px-4 bg-surface-alt rounded-md">
    <span class="font-bold mr-auto">Brand</span>
    <!-- Container query: switch at the md equivalent (48rem / 768px) -->
    <div class="flex gap-4 @max-3xl:hidden">
      {links.map((label) => <a href="#">{label}</a>)}
    </div>
    <details
      class="hamburger relative hidden @max-3xl:block [interpolate-size:allow-keywords] details-content:h-0 details-content:overflow-hidden details-content:opacity-0 details-content:transition-[height,opacity] details-content:duration-200 details-content:ease-[ease] open:details-content:h-auto open:details-content:opacity-100"
    >
      <summary
        aria-label="Menu"
        class="cursor-pointer text-2xl list-none [&::-webkit-details-marker]:hidden"
        >&#9776;</summary
      >
      <div
        class="dropdown absolute right-0 top-full bg-surface border border-border rounded-sm p-2 flex flex-col gap-1 min-w-[150px]"
      >
        {
          links.map((label) => (
            <a href="#" class="p-2 rounded-sm hover:bg-surface-alt">
              {label}
            </a>
          ))
        }
      </div>
    </details>
  </nav>
</div>
