---
import PrimaryButton from "./PrimaryButton.astro";
import SelectField from "./SelectField.astro";

interface Props {
  overlayId: string;
}
const { overlayId } = Astro.props;
---

<div id="state-idle">
  <h3 class="mb-4">Action Settings</h3>
  <div class="grid gap-4 max-w-[400px]">
    <SelectField label="Delay" id="cfg-delay">
      <option value="300">300ms</option>
      <option value="1000" selected>1 sec</option>
      <option value="3000">3 sec</option>
    </SelectField>
    <SelectField label="Result" id="cfg-result">
      <option value="success">Success</option>
      <option value="error">Error (ActionError)</option>
    </SelectField>
    <SelectField label="After completion" id="cfg-after">
      <option value="overlay">Show in overlay, then close</option>
      <option value="navigate">Navigate with ?status= (URL canonical)</option>
    </SelectField>
    <PrimaryButton command="show-modal" commandfor={overlayId}
      >Execute Action</PrimaryButton
    >
  </div>
</div>
