---
import FormField from "./FormField.astro";
import PrimaryButton from "./PrimaryButton.astro";
import TextAreaField from "./TextAreaField.astro";

interface Props {
  action: string;
}
const { action } = Astro.props;
---

<!-- GET back to this page, not POST: GitHub Pages serves static files and
     has nothing to accept a POST. The action must carry BASE_URL, or the
     submit leaves the site root and 404s. Inputs carry no `name`, so the GET
     puts no personal data in the URL; the draft is keyed by id instead. -->
<form id="draft-form" method="get" action={action}>
  <div class="grid gap-4 max-w-[400px]">
    <FormField label="Name" type="text" id="draft-name" autocomplete="name" />
    <FormField
      label="Email"
      type="email"
      id="draft-email"
      autocomplete="email"
    />
    <TextAreaField label="Message" id="draft-message" rows={3} />
    <PrimaryButton type="submit">Submit</PrimaryButton>
  </div>
</form>

<script>
  const KEY = "draft-form-data";

  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById(
      "draft-form",
    ) as HTMLFormElement | null;
    if (!form) return;

    // Restore
    const saved = sessionStorage.getItem(KEY);
    if (saved) {
      const data = JSON.parse(saved);
      for (const [id, value] of Object.entries(data)) {
        const el = form.elements.namedItem(id);
        if (
          el instanceof HTMLInputElement ||
          el instanceof HTMLTextAreaElement
        ) {
          el.value = value as string;
        }
      }
    }

    // Save on input
    form.addEventListener("input", () => {
      const data: Record<string, string> = {};
      for (const el of form.elements) {
        if (
          (el instanceof HTMLInputElement ||
            el instanceof HTMLTextAreaElement) &&
          el.id
        ) {
          data[el.id] = el.value;
        }
      }
      sessionStorage.setItem(KEY, JSON.stringify(data));
    });

    // Clear on submit
    form.addEventListener("submit", () => {
      sessionStorage.removeItem(KEY);
    });
  });
</script>
