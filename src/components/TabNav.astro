---
interface Props {
  tabs: string[];
  current: string;
}
const { tabs, current } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!-- Each tab is a page, so this is navigation, not an ARIA tablist:
     links keep link semantics and aria-current marks the active one. -->
<nav class="flex border-b-2 border-border" aria-label="Demo tabs">
  {
    tabs.map((t) => (
      <a
        href={`${base}navigation/tabs/${t}`}
        aria-current={t === current ? "page" : undefined}
        class="py-2 px-4 no-underline text-muted -mb-0.5 hover:not-aria-[current=page]:text-foreground aria-[current=page]:text-primary aria-[current=page]:border-b-2 aria-[current=page]:border-primary"
      >
        Tab {t.toUpperCase()}
      </a>
    ))
  }
</nav>
