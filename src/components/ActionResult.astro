---
import PrimaryLink from "./PrimaryLink.astro";

interface Props {
  status: "complete" | "error";
  resetHref: string;
}
const { status, resetHref } = Astro.props;
const ok = status === "complete";
---

<!-- Rendered hidden; the page script reveals the one ?status= names -->
<div id={`state-${status}`} hidden>
  <div
    class:list={[
      "p-6 rounded-md max-w-[400px]",
      ok ? "bg-surface-alt" : "border border-danger",
    ]}
  >
    <div class="flex items-center gap-3 mb-4">
      <span
        class:list={[
          "inline-flex items-center justify-center w-10 h-10 rounded-full text-xl",
          ok ? "bg-success text-on-success" : "bg-danger text-on-danger",
        ]}>{ok ? "✓" : "!"}</span
      >
      <h3>{ok ? "Action Complete" : "Action Failed"}</h3>
    </div>
    <p class="text-muted mb-4">
      {
        ok
          ? "The action has been processed."
          : "An error occurred during processing."
      } This state is derived from <code>?status={status}</code> in the URL.
    </p>
    {
      ok && (
        <p class="text-muted text-sm mb-4">
          Reload the page — the completion state persists because the URL is
          the canonical source.
        </p>
      )
    }
    <PrimaryLink href={resetHref}>{ok ? "Reset" : "Retry"}</PrimaryLink>
  </div>
</div>
