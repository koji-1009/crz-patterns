<div class="grid gap-4 max-w-[500px]">
  <div class="p-4 bg-surface border border-border rounded-md">
    <strong>Surface</strong> — bg-surface + border-border
  </div>
  <div class="p-4 bg-surface-alt rounded-md">
    <strong>Surface Alt</strong> — bg-surface-alt
  </div>
  <div class="p-4 bg-primary text-on-primary rounded-md">
    <strong>Primary</strong> — bg-primary + text-on-primary
  </div>
  <div class="p-4 bg-danger text-on-danger rounded-md">
    <strong>Danger</strong> — bg-danger + text-on-danger
  </div>
  <div class="p-4 bg-success text-on-success rounded-md">
    <strong>Success</strong> — bg-success + text-on-success
  </div>
  <p class="text-muted text-sm">
    All these colors switch automatically through <code>color-scheme</code>.
    No per-component logic needed.
  </p>
</div>
