---
interface Props {
  label: string;
  id: string;
  code: string;
}
const { label, id, code } = Astro.props;
---

<div>
  <div class="flex items-center justify-between mb-1">
    <span class="text-sm text-muted">{label}</span>
    <button
      type="button"
      command="--copy"
      commandfor={id}
      class="copy-btn text-sm text-primary border border-border rounded-sm px-2 py-0.5 cursor-pointer hover:bg-surface-alt transition-colors duration-200 data-[state=copied]:bg-success data-[state=copied]:text-on-success data-[state=copied]:border-success data-[state=failed]:bg-danger data-[state=failed]:text-on-danger data-[state=failed]:border-danger"
      >Copy</button
    >
  </div>
  <pre
    id={id}
    class="copy-target p-4 bg-surface-alt rounded-sm overflow-x-auto text-sm">{code}</pre>
</div>

<script>
  // Runs once for every instance — the listener lives on the copy target,
  // and event.source gives back whichever button was pressed.
  document.querySelectorAll(".copy-target").forEach((target) => {
    target.addEventListener("command", async (event) => {
      const { command, source } = event as Event & {
        command: string;
        source: Element | null;
      };
      if (command !== "--copy") return;
      const btn = source as HTMLButtonElement | null;
      if (!btn) return;

      // writeText rejects when the clipboard is refused (permission policy,
      // an insecure origin, a locked-down browser). Without this catch the
      // rejection ends the handler and the button silently does nothing.
      let ok = true;
      try {
        await navigator.clipboard.writeText(target.textContent ?? "");
      } catch {
        ok = false;
      }

      btn.textContent = ok ? "Copied!" : "Copy failed";
      btn.dataset.state = ok ? "copied" : "failed";
      setTimeout(() => {
        btn.textContent = "Copy";
        delete btn.dataset.state;
      }, 2000);
    });
  });
</script>
