---
import DndLimitations from "../../components/DndLimitations.astro";
import SortableList from "../../components/SortableList.astro";
import PatternLayout from "../../layouts/PatternLayout.astro";
---

<PatternLayout
  title="Drag & Drop Reorder"
  assumption="dnd-kit / react-beautiful-dnd required"
  technique="HTML5 Drag and Drop API (draggable, dragover, drop)"
  layer="1"
  jsShipped="inline <script> only"
>
  <DndLimitations />
  <SortableList items={["Apple", "Banana", "Cherry", "Date", "Elderberry"]} />
</PatternLayout>
