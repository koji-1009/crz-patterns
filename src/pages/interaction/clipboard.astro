---
import PatternLayout from "../../layouts/PatternLayout.astro";
import CopyBlock from "../../components/CopyBlock.astro";

const jsSnippet = `const greeting = "Hello, World!";
console.log(greeting);`;

const shellSnippet = `npm create astro@latest
cd my-project
npm run dev`;

const cssSnippet = `.container {
  display: grid;
  gap: 1rem;
  max-width: 960px;
  margin: 0 auto;
}`;
---

<PatternLayout
  title="Clipboard Copy"
  assumption="useState + useRef + document.execCommand"
  technique="custom command (--copy) + navigator.clipboard.writeText()"
  layer="1"
  jsShipped="inline <script> only"
>
  <div class="grid gap-4 max-w-[500px]">
    <CopyBlock label="JavaScript" id="snippet-js" code={jsSnippet} />
    <CopyBlock label="Shell" id="snippet-shell" code={shellSnippet} />
    <CopyBlock label="CSS" id="snippet-css" code={cssSnippet} />
  </div>
</PatternLayout>
