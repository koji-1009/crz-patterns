---
import DraftForm from "../../components/DraftForm.astro";
import PatternLayout from "../../layouts/PatternLayout.astro";
const base = import.meta.env.BASE_URL;
---

<PatternLayout
  title="Draft Persistence"
  assumption="state management library + Context required"
  technique="sessionStorage + <script>"
  layer="1"
  jsShipped="inline <script> only"
>
  <DraftForm action={`${base}forms/draft`} />
  <p class="mt-4"><a href={`${base}forms/draft-away`}>Navigate away →</a></p>
</PatternLayout>
