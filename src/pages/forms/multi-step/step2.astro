---
import FormField from "../../../components/FormField.astro";
import PrimaryButton from "../../../components/PrimaryButton.astro";
import PatternLayout from "../../../layouts/PatternLayout.astro";
const base = import.meta.env.BASE_URL;
---

<PatternLayout
  title="Multi-step Form — Step 2 of 3"
  assumption="useState + Router for step management"
  technique="sessionStorage for inter-step data + URL for current step"
  layer="1"
  jsShipped="inline <script> only"
>
  <p class="text-muted mb-4">Step 2: Contact Details</p>
  <div id="step1-summary" class="p-3 bg-surface-alt rounded-sm mb-4 text-sm">
  </div>
  <!-- Same fallback as step 1: the action is the next step, inputs are
       unnamed so the no-JS GET carries no personal data. -->
  <form
    id="step-form"
    action={`${base}forms/multi-step/step3`}
    class="grid gap-4 max-w-[400px]"
  >
    <FormField
      label="Address"
      type="text"
      id="field-address"
      value="123 Main St"
      autocomplete="street-address"
    />
    <FormField
      label="Phone"
      type="tel"
      id="field-phone"
      value="090-1234-5678"
      autocomplete="tel"
    />
    <div class="flex gap-4">
      <a
        href={`${base}forms/multi-step/step1`}
        class="px-4 py-2 border border-border rounded-sm">&larr; Back</a
      >
      <PrimaryButton type="submit">Next &rarr;</PrimaryButton>
    </div>
  </form>
  <script>
    const KEY = "multi-step";

    document.addEventListener("DOMContentLoaded", () => {
      const summary = document.getElementById(
        "step1-summary",
      ) as HTMLElement | null;
      const form = document.getElementById(
        "step-form",
      ) as HTMLFormElement | null;
      const addressEl = document.getElementById(
        "field-address",
      ) as HTMLInputElement | null;
      const phoneEl = document.getElementById(
        "field-phone",
      ) as HTMLInputElement | null;
      if (!summary || !form || !addressEl || !phoneEl) return;

      const saved = sessionStorage.getItem(KEY);
      if (!saved) {
        window.location.assign(`${import.meta.env.BASE_URL}forms/multi-step/step1`);
        return;
      }
      const d = JSON.parse(saved);
      summary.textContent = `Step 1: ${d.name ?? ""} / ${d.email ?? ""}`;
      if (d.address) addressEl.value = d.address;
      if (d.phone) phoneEl.value = d.phone;

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const data = { ...d, address: addressEl.value, phone: phoneEl.value };
        sessionStorage.setItem(KEY, JSON.stringify(data));
        window.location.assign(form.action);
      });
    });
  </script>
</PatternLayout>
