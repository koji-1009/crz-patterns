---
import PrimaryButton from "../../../components/PrimaryButton.astro";
import SecondaryLink from "../../../components/SecondaryLink.astro";
import PatternLayout from "../../../layouts/PatternLayout.astro";
const base = import.meta.env.BASE_URL;
---

<PatternLayout
  title="Multi-step Form — Step 3 of 3"
  assumption="useState + Router for step management"
  technique="sessionStorage for inter-step data + URL for current step"
  layer="1"
  jsShipped="inline <script> only"
>
  <p class="text-muted mb-4">Step 3: Confirmation</p>
  <div
    id="confirm"
    class="grid gap-2 p-4 bg-surface-alt rounded-sm max-w-[400px] mb-4"
  >
  </div>
  <!-- Live region for the submit outcome. It also takes focus, since the
       button that had it is removed. -->
  <p
    id="submit-result"
    role="status"
    tabindex="-1"
    class="p-4 bg-surface-alt rounded-sm max-w-[400px] mb-4 empty:hidden"
  ></p>
  <div class="flex gap-4">
    <SecondaryLink href={`${base}forms/multi-step/step2`}
      >&larr; Back</SecondaryLink
    >
    <PrimaryButton id="submit-btn">Confirm & Submit</PrimaryButton>
  </div>
  <script>
    const KEY = "multi-step";

    document.addEventListener("DOMContentLoaded", () => {
      const container = document.getElementById(
        "confirm",
      ) as HTMLElement | null;
      const btn = document.getElementById(
        "submit-btn",
      ) as HTMLButtonElement | null;
      const result = document.getElementById("submit-result");
      if (!container || !btn || !result) return;

      const saved = sessionStorage.getItem(KEY);
      if (!saved) {
        window.location.assign(`${import.meta.env.BASE_URL}forms/multi-step/step1`);
        return;
      }
      const d = JSON.parse(saved);

      container.innerHTML = "";
      const fields = [
        ["Name", d.name],
        ["Email", d.email],
        ["Address", d.address],
        ["Phone", d.phone],
      ] as const;
      for (const [label, value] of fields) {
        const row = document.createElement("div");
        const strong = document.createElement("strong");
        strong.textContent = `${label}: `;
        row.appendChild(strong);
        // A text node is never parsed as HTML, so it needs no escaping
        row.appendChild(document.createTextNode(value ?? ""));
        container.appendChild(row);
      }

      btn.addEventListener("click", () => {
        sessionStorage.removeItem(KEY);
        container.remove();
        result.textContent = "Submitted! All data cleared from sessionStorage.";
        btn.remove();
        result.focus();
      });
    });
  </script>
</PatternLayout>
