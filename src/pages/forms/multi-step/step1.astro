---
import FormField from "../../../components/FormField.astro";
import PrimaryButton from "../../../components/PrimaryButton.astro";
import PatternLayout from "../../../layouts/PatternLayout.astro";
const base = import.meta.env.BASE_URL;
---

<PatternLayout
  title="Multi-step Form — Step 1 of 3"
  assumption="useState + Router for step management"
  technique="sessionStorage for inter-step data + URL for current step"
  layer="1"
  jsShipped="inline <script> only"
>
  <p class="text-muted mb-4">Step 1: Basic Info</p>
  <!-- The form's action is the next step, so "Next" still navigates if the
       script fails. Inputs carry no `name`, so that fallback GET puts no
       personal data in the URL. -->
  <form
    id="step-form"
    action={`${base}forms/multi-step/step2`}
    class="grid gap-4 max-w-[400px]"
  >
    <FormField
      label="Name"
      type="text"
      id="field-name"
      value="John Doe"
      autocomplete="name"
    />
    <FormField
      label="Email"
      type="email"
      id="field-email"
      value="john@example.com"
      autocomplete="email"
    />
    <PrimaryButton type="submit">Next &rarr;</PrimaryButton>
  </form>
  <script>
    const KEY = "multi-step";

    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById(
        "step-form",
      ) as HTMLFormElement | null;
      const nameEl = document.getElementById(
        "field-name",
      ) as HTMLInputElement | null;
      const emailEl = document.getElementById(
        "field-email",
      ) as HTMLInputElement | null;
      if (!form || !nameEl || !emailEl) return;

      const saved = sessionStorage.getItem(KEY);
      if (saved) {
        const d = JSON.parse(saved);
        nameEl.value = d.name ?? nameEl.value;
        emailEl.value = d.email ?? emailEl.value;
      }

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const prev = saved ? JSON.parse(saved) : {};
        const data = { ...prev, name: nameEl.value, email: emailEl.value };
        sessionStorage.setItem(KEY, JSON.stringify(data));
        window.location.assign(form.action);
      });
    });
  </script>
</PatternLayout>
