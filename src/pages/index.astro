---
import PatternLink from "../components/PatternLink.astro";
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;

const SCRIPT = "inline <script> only";

const sections = [
  {
    title: "Forms & Input",
    patterns: [
      { name: "Draft Persistence", path: "forms/draft", meta: `Layer 1 / ${SCRIPT}` },
      { name: "Input Validation", path: "forms/validation", meta: `Layer 1 / ${SCRIPT}` },
      { name: "Multi-step Form", path: "forms/multi-step/step1", meta: `Layer 1 / ${SCRIPT}` },
    ],
  },
  {
    title: "Navigation & Views",
    patterns: [
      { name: "Tabs", path: "navigation/tabs/a", meta: "Layer 1 / 0 KB JS" },
      { name: "Accordion", path: "navigation/accordion", meta: "Layer 1-2 / 0 KB JS" },
    ],
  },
  {
    title: "UI Components",
    patterns: [
      { name: "Dialog", path: "components/dialog", meta: "Layer 1-2 / 0 KB JS" },
      { name: "Tooltip", path: "components/tooltip", meta: "Layer 1-2 / 0 KB JS" },
      { name: "Toast Notification", path: "components/toast", meta: `Layer 1-2 / ${SCRIPT}` },
      { name: "Carousel", path: "components/carousel", meta: "Layer 2 / 0 KB JS" },
      { name: "Lightbox", path: "components/lightbox", meta: `Layer 1-2 / ${SCRIPT}` },
      { name: "Hamburger Menu", path: "components/hamburger", meta: "Layer 1-2 / 0 KB JS" },
      { name: "Dark Mode Toggle", path: "components/dark-mode", meta: `Layer 1-2 / ${SCRIPT}` },
      { name: "Loading Overlay", path: "components/loading-overlay", meta: `Layer 1-2 / ${SCRIPT}` },
    ],
  },
  {
    title: "Interaction",
    patterns: [
      { name: "Drag & Drop", path: "interaction/drag-drop", meta: `Layer 1 / ${SCRIPT}` },
      { name: "Clipboard", path: "interaction/clipboard", meta: `Layer 1 / ${SCRIPT}` },
    ],
  },
  {
    title: "Extra",
    patterns: [
      { name: "Infinite Scroll (Feed)", path: "extra/infinite-scroll", meta: `Layer 1-3 / ${SCRIPT}` },
      { name: "Seamless Pagination", path: "extra/seamless-paging/1", meta: `Layer 1-3 / ${SCRIPT}` },
    ],
  },
];
---

<Layout title="CRZ Pattern Catalog">
  <main>
    <h1 class="text-xl font-bold">Pattern Catalog</h1>
    {
      sections.map((section) => (
        <section>
          <h2 class="mt-8 mb-3 text-sm text-muted uppercase tracking-wide font-bold">
            {section.title}
          </h2>
          {section.patterns.map((p) => (
            <PatternLink href={`${base}${p.path}`} name={p.name} meta={p.meta} />
          ))}
        </section>
      ))
    }
  </main>
</Layout>
