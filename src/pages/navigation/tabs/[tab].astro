---
import TabNav from "../../../components/TabNav.astro";
import TabPanel from "../../../components/TabPanel.astro";
import PatternLayout from "../../../layouts/PatternLayout.astro";

export function getStaticPaths() {
  return [
    { params: { tab: "a" } },
    { params: { tab: "b" } },
    { params: { tab: "c" } },
  ];
}

const { tab } = Astro.params;
const tabs = ["a", "b", "c"];
---

<PatternLayout
  title="Tabs"
  assumption="useState + onClick handler"
  technique="URL path + <nav> + aria-current"
  layer="1"
  jsShipped="0 KB"
>
  <TabNav tabs={tabs} current={tab!} />
  <TabPanel tab={tab!} />
</PatternLayout>
