---
import TabPanel from "../../../components/TabPanel.astro";
import PatternLayout from "../../../layouts/PatternLayout.astro";

export function getStaticPaths() {
  return [
    { params: { tab: "a" } },
    { params: { tab: "b" } },
    { params: { tab: "c" } },
  ];
}

const { tab } = Astro.params;
const base = import.meta.env.BASE_URL;
const tabs = ["a", "b", "c"];
---

<PatternLayout
  title="Tabs"
  assumption="useState + onClick handler"
  technique="URL path + <nav> + aria-current"
  layer="1"
  jsShipped="0 KB"
>
  <!-- Each tab is a page, so this is navigation, not an ARIA tablist:
       links keep link semantics and aria-current marks the active one. -->
  <nav class="flex border-b-2 border-border" aria-label="Demo tabs">
    {
      tabs.map((t) => (
        <a
          href={`${base}navigation/tabs/${t}`}
          aria-current={t === tab ? "page" : undefined}
          class="py-2 px-4 no-underline text-muted -mb-0.5 hover:not-aria-[current=page]:text-foreground aria-[current=page]:text-primary aria-[current=page]:border-b-2 aria-[current=page]:border-primary"
        >
          Tab {t.toUpperCase()}
        </a>
      ))
    }
  </nav>
  <TabPanel tab={tab!} />
</PatternLayout>
