---
import PatternLayout from "../../layouts/PatternLayout.astro";
const images = Array.from({ length: 6 }, (_, i) => i + 1);
---

<PatternLayout
  title="Image Lightbox"
  assumption="react-lightbox / state + portal + keyboard handling"
  technique="<dialog> + command/commandfor + CSS object-fit: contain"
  layer="1-2"
  jsShipped="inline <script> only"
>
  <div class="grid grid-cols-3 gap-2 max-w-[500px]">
    {
      images.map((id) => (
        <button
          type="button"
          command="show-modal"
          commandfor="lightbox"
          class="thumb"
          data-id={id}
          aria-label={`Open image ${id}`}
        >
          <img
            src={`https://picsum.photos/seed/${id}/200/200`}
            alt={`Thumbnail ${id}`}
            width="200"
            height="200"
            loading="lazy"
            class="w-full h-auto rounded-sm"
          />
        </button>
      ))
    }
  </div>

  <dialog
    id="lightbox"
    closedby="any"
    class="relative border-none bg-transparent p-0 max-w-[90vw] max-h-[90vh]"
  >
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="rounded-md max-w-[80vw] max-h-[80vh] object-contain"
    />
    <!-- closedby="any" is an enhancement, so an explicit close control has to
         stay: without it a browser that ignores the attribute has no way out. -->
    <button
      type="button"
      command="close"
      commandfor="lightbox"
      aria-label="Close image"
      class="absolute top-2 right-2 w-9 h-9 rounded-full border-none bg-black/60 text-white text-xl leading-none cursor-pointer hover:bg-black/80"
      >&times;</button
    >
  </dialog>

  <style>
    dialog {
      outline: none;
    }
    dialog::backdrop {
      background: rgba(0, 0, 0, 0.85);
    }
    dialog[open] {
      margin: auto;
    }
    .thumb {
      padding: 0;
      border: none;
      cursor: pointer;
      background: none;
      -webkit-tap-highlight-color: transparent;
    }
    .thumb img {
      pointer-events: none;
    }
    #lightbox-img {
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    #lightbox-img.loaded {
      opacity: 1;
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const dialog = document.getElementById(
        "lightbox",
      ) as HTMLDialogElement | null;
      const img = document.getElementById(
        "lightbox-img",
      ) as HTMLImageElement | null;
      if (!dialog || !img) return;

      // The browser owns the invocation; the listener only swaps the source.
      dialog.addEventListener("command", (event) => {
        const { command, source } = event as Event & {
          command: string;
          source: Element | null;
        };
        if (command !== "show-modal") return;
        const id = (source as HTMLElement | null)?.dataset.id;
        img.classList.remove("loaded");
        img.src = `https://picsum.photos/seed/${id}/800/600`;
        img.alt = `Image ${id}`;
      });

      img.addEventListener("load", () => {
        img.classList.add("loaded");
      });
    });
  </script>
</PatternLayout>
