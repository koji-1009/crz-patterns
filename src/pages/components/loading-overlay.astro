---
import ActionResult from "../../components/ActionResult.astro";
import ActionSettings from "../../components/ActionSettings.astro";
import ProcessingOverlay from "../../components/ProcessingOverlay.astro";
import PatternLayout from "../../layouts/PatternLayout.astro";
const base = import.meta.env.BASE_URL;
const resetHref = `${base}components/loading-overlay`;
---

<PatternLayout
  title="Loading Overlay"
  assumption="isLoading useState + Suspense + portal"
  technique="<dialog> + command/commandfor + closedby + URL canonical source"
  layer="1-2"
  jsShipped="inline <script> only"
>
  <p class="text-muted mb-6 text-sm border-l-2 border-muted pl-3">
    Full-screen blocking overlay should be reserved for operations where the
    user must wait (payment, destructive action, export). For data loading,
    prefer partial indicators or browser-native navigation.
  </p>

  <ActionSettings overlayId="overlay" />
  <ActionResult status="complete" resetHref={resetHref} />
  <ActionResult status="error" resetHref={resetHref} />
  <ProcessingOverlay id="overlay" />

  <script>
    // Page-level: this wiring reads the settings, drives the overlay and
    // swaps the result sections, so it spans every section above.
    document.addEventListener("DOMContentLoaded", () => {
      const byId = (id: string) => document.getElementById(id);
      const idle = byId("state-idle");
      const stateComplete = byId("state-complete");
      const stateError = byId("state-error");
      const overlay = byId("overlay") as HTMLDialogElement | null;
      const olLoading = byId("ol-loading");
      const olSuccess = byId("ol-success");
      const olError = byId("ol-error");
      const cfgDelay = byId("cfg-delay") as HTMLSelectElement | null;
      const cfgResult = byId("cfg-result") as HTMLSelectElement | null;
      const cfgAfter = byId("cfg-after") as HTMLSelectElement | null;
      if (
        !idle ||
        !stateComplete ||
        !stateError ||
        !overlay ||
        !olLoading ||
        !olSuccess ||
        !olError ||
        !cfgDelay ||
        !cfgResult ||
        !cfgAfter
      )
        return;

      // URL-driven state: check on load
      const status = new URLSearchParams(window.location.search).get("status");
      if (status === "complete") {
        idle.hidden = true;
        stateComplete.hidden = false;
      } else if (status === "error") {
        idle.hidden = true;
        stateError.hidden = false;
      }

      // The button opens the overlay; this only runs the simulated work.
      overlay.addEventListener("command", (event) => {
        const { command } = event as Event & { command: string };
        if (command !== "show-modal") return;

        olLoading.hidden = false;
        olSuccess.hidden = true;
        olError.hidden = true;

        const delay = Number(cfgDelay.value);
        const success = cfgResult.value === "success";
        const after = cfgAfter.value;

        setTimeout(() => {
          if (after === "navigate") {
            // No user action here — a timer fired, so the close is programmatic
            overlay.close();
            window.location.assign(`?status=${success ? "complete" : "error"}`);
          } else {
            olLoading.hidden = true;
            olSuccess.hidden = !success;
            olError.hidden = success;
          }
        }, delay);
      });
    });
  </script>
</PatternLayout>
