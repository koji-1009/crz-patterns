---
import Toast from "../../components/Toast.astro";
import PatternLayout from "../../layouts/PatternLayout.astro";
---

<PatternLayout
  title="Toast Notification"
  assumption="react-toastify / state + portal + timer"
  technique="Popover API + command/commandfor + CSS transition"
  layer="1-2"
  jsShipped="inline <script> only"
>
  <div class="flex gap-3 flex-wrap">
    <button
      type="button"
      command="show-popover"
      commandfor="toast"
      class="bg-success text-on-success border border-success rounded-sm px-4 py-2 cursor-pointer"
      data-type="success">Success</button
    >
    <button
      type="button"
      command="show-popover"
      commandfor="toast"
      class="bg-danger text-on-danger border border-danger rounded-sm px-4 py-2 cursor-pointer"
      data-type="error">Error</button
    >
    <button
      type="button"
      command="show-popover"
      commandfor="toast"
      class="bg-primary text-on-primary border border-primary rounded-sm px-4 py-2 cursor-pointer"
      data-type="info">Info</button
    >
  </div>

  <Toast id="toast" />
</PatternLayout>
