---
import Toast from "../../components/Toast.astro";
import PatternLayout from "../../layouts/PatternLayout.astro";

// Full class strings, not built from the type name: Tailwind only generates
// utilities it can find written out in the source.
const triggers = [
  { type: "success", label: "Success", color: "bg-success text-on-success border-success" },
  { type: "error", label: "Error", color: "bg-danger text-on-danger border-danger" },
  { type: "info", label: "Info", color: "bg-primary text-on-primary border-primary" },
];
---

<PatternLayout
  title="Toast Notification"
  assumption="react-toastify / state + portal + timer"
  technique="Popover API + command/commandfor + CSS transition"
  layer="1-2"
  jsShipped="inline <script> only"
>
  <div class="flex gap-3 flex-wrap">
    {
      triggers.map((t) => (
        <button
          type="button"
          command="show-popover"
          commandfor="toast"
          class:list={["border rounded-sm px-4 py-2 cursor-pointer", t.color]}
          data-type={t.type}
        >
          {t.label}
        </button>
      ))
    }
  </div>

  <Toast id="toast" />
</PatternLayout>
