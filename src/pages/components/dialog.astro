---
import PatternLayout from "../../layouts/PatternLayout.astro";
---

<PatternLayout
  title="Modal / Dialog"
  assumption="createPortal + useState + focus trap library"
  technique="<dialog> + command/commandfor + closedby + CSS @starting-style"
  layer="1-2"
  jsShipped="0 KB"
>
  <div class="flex gap-3 flex-wrap">
    <button
      type="button"
      command="show-modal"
      commandfor="dialog-dismissible"
      class="bg-primary text-white border border-primary rounded-sm px-4 py-2 cursor-pointer hover:bg-primary-hover"
      >Dismissible Dialog</button
    >
    <button
      type="button"
      command="show-modal"
      commandfor="dialog-persistent"
      class="bg-primary text-white border border-primary rounded-sm px-4 py-2 cursor-pointer hover:bg-primary-hover"
      >Persistent Dialog</button
    >
  </div>

  <!-- Dismissible: closedby="any" gives backdrop click + Esc, no listener -->
  <dialog
    id="dialog-dismissible"
    closedby="any"
    class="border border-border rounded-md p-6 w-[calc(100%-2rem)] max-w-[400px] bg-surface text-foreground"
  >
    <h2 class="mb-4">Dismissible Dialog</h2>
    <p class="mb-4">
      Backdrop click closes. Esc closes. This is the default behavior for
      informational dialogs.
    </p>
    <button
      type="button"
      command="close"
      commandfor="dialog-dismissible"
      class="bg-primary text-white border border-primary rounded-sm px-4 py-2 cursor-pointer hover:bg-primary-hover"
      >Close</button
    >
  </dialog>

  <!-- Persistent: closedby="none" refuses every close request -->
  <dialog
    id="dialog-persistent"
    closedby="none"
    class="border border-border rounded-md p-6 w-[calc(100%-2rem)] max-w-[400px] bg-surface text-foreground"
  >
    <h2 class="mb-4">Persistent Dialog</h2>
    <p class="mb-4">
      Backdrop click does <strong>not</strong> close. Esc does <strong
        >not</strong
      > close. The user must explicitly act. Use for confirmations, destructive actions,
      or required input.
    </p>
    <div class="flex gap-3">
      <button
        type="button"
        command="close"
        commandfor="dialog-persistent"
        value="cancel"
        class="border border-border rounded-sm px-4 py-2 cursor-pointer hover:bg-surface-alt"
        >Cancel</button
      >
      <button
        type="button"
        command="close"
        commandfor="dialog-persistent"
        value="confirm"
        class="bg-primary text-white border border-primary rounded-sm px-4 py-2 cursor-pointer hover:bg-primary-hover"
        >Confirm</button
      >
    </div>
  </dialog>

  <style>
    dialog {
      margin: auto;
      opacity: 0;
      transform: scale(0.95);
      transition:
        opacity 0.2s ease,
        transform 0.2s ease,
        display 0.2s ease allow-discrete,
        overlay 0.2s ease allow-discrete;
    }
    dialog[open] {
      opacity: 1;
      transform: scale(1);
    }
    @starting-style {
      dialog[open] {
        opacity: 0;
        transform: scale(0.95);
      }
    }

    dialog::backdrop {
      background: rgba(0, 0, 0, 0);
      transition:
        background 0.2s ease,
        display 0.2s ease allow-discrete,
        overlay 0.2s ease allow-discrete;
    }
    dialog[open]::backdrop {
      background: rgba(0, 0, 0, 0.5);
    }
    @starting-style {
      dialog[open]::backdrop {
        background: rgba(0, 0, 0, 0);
      }
    }
  </style>
</PatternLayout>
