---
import DemoDialog from "../../components/DemoDialog.astro";
import PrimaryButton from "../../components/PrimaryButton.astro";
import PatternLayout from "../../layouts/PatternLayout.astro";
---

<PatternLayout
  title="Modal / Dialog"
  assumption="createPortal + useState + focus trap library"
  technique="<dialog> + command/commandfor + closedby + CSS @starting-style"
  layer="1-2"
  jsShipped="0 KB"
>
  <div class="flex gap-3 flex-wrap">
    <PrimaryButton command="show-modal" commandfor="dialog-dismissible"
      >Dismissible Dialog</PrimaryButton
    >
    <PrimaryButton command="show-modal" commandfor="dialog-persistent"
      >Persistent Dialog</PrimaryButton
    >
  </div>

  <!-- Dismissible: closedby="any" gives backdrop click + Esc, no listener -->
  <DemoDialog id="dialog-dismissible" title="Dismissible Dialog" closedby="any">
    <p class="mb-4">
      Backdrop click closes. Esc closes. This is the default behavior for
      informational dialogs.
    </p>
    <PrimaryButton command="close" commandfor="dialog-dismissible"
      >Close</PrimaryButton
    >
  </DemoDialog>

  <!-- Persistent: closedby="none" refuses every close request -->
  <DemoDialog id="dialog-persistent" title="Persistent Dialog" closedby="none">
    <p class="mb-4">
      Backdrop click does <strong>not</strong> close. Esc does <strong
        >not</strong
      > close. The user must explicitly act. Use for confirmations, destructive actions,
      or required input.
    </p>
    <div class="flex gap-3">
      <button
        type="button"
        command="close"
        commandfor="dialog-persistent"
        value="cancel"
        class="border border-border rounded-sm px-4 py-2 cursor-pointer hover:bg-surface-alt"
        >Cancel</button
      >
      <PrimaryButton command="close" commandfor="dialog-persistent" value="confirm"
        >Confirm</PrimaryButton
      >
    </div>
  </DemoDialog>
</PatternLayout>
