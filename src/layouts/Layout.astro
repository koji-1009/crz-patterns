---
import "../styles/app.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<html lang="en" id="theme-root">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      /* With no stored preference the CSS follows prefers-color-scheme on its
         own; this only pins a theme the user chose before paint. */
      (function () {
        try {
          var s = localStorage.getItem("theme-preference");
          if (s === "dark" || s === "light")
            document.documentElement.classList.add(s);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-bg text-foreground">
    <header
      class="sticky top-0 z-10 bg-bg px-4 py-4 mb-6 border-b border-border flex items-center justify-between"
    >
      <a
        href={base}
        class="text-lg font-bold text-foreground no-underline hover:text-primary"
        >CRZ Patterns</a
      >
      <button
        type="button"
        command="--toggle-theme"
        commandfor="theme-root"
        class="text-sm text-muted border border-border rounded-sm px-3 py-1 cursor-pointer hover:bg-surface-alt"
        aria-label="Toggle dark mode"
        ><span class="dark:hidden">Dark</span><span class="hidden dark:inline"
          >Light</span
        ></button
      >
    </header>
    <div class="px-4">
      <slot />
    </div>
    <footer
      class="px-4 py-4 mt-12 border-t border-border text-sm text-muted"
    >
      Based on <a
        href="https://github.com/koji-1009/crumple-zone-architecture"
        class="text-primary">Crumple Zone Architecture</a
      >
      · Built with <a href="https://astro.build" class="text-primary">Astro</a>
      + <a href="https://tailwindcss.com" class="text-primary">Tailwind CSS</a>
    </footer>
    <script is:inline>
      /* Crumple zone for `closedby`. Chrome 134 and Firefox 141 ship it, but
         Safari has it in preview only, so released Safari and iOS Safari
         ignore the attribute: `any` never light-dismisses and `none` never
         refuses a close request. One project-wide fallback, feature-detected,
         to be deleted when Safari ships. */
      (function () {
        if ("closedBy" in HTMLDialogElement.prototype) return;
        document.addEventListener("DOMContentLoaded", function () {
          document.querySelectorAll("dialog[closedby]").forEach(function (d) {
            var mode = d.getAttribute("closedby");
            if (mode === "none") {
              d.addEventListener("cancel", function (e) {
                e.preventDefault();
              });
            } else if (mode === "any") {
              /* Listen on the dialog itself, not the document: iOS Safari
                 does not deliver clicks from non-interactive elements to
                 delegated handlers. A click whose target is the dialog landed
                 on either its padding or the backdrop, so compare against the
                 box to tell them apart. */
              d.addEventListener("click", function (e) {
                if (e.target !== d) return;
                var r = d.getBoundingClientRect();
                if (
                  e.clientX < r.left ||
                  e.clientX > r.right ||
                  e.clientY < r.top ||
                  e.clientY > r.bottom
                ) {
                  d.close();
                }
              });
            }
          });
        });
      })();
    </script>
    <script is:inline>
      /* The button's label is CSS (the `dark:` variant); this listener on the
         command target only flips the pinned theme and stores it. */
      (function () {
        var root = document.documentElement;
        root.addEventListener("command", function (e) {
          if (e.command !== "--toggle-theme") return;
          var dark =
            root.classList.contains("dark") ||
            (!root.classList.contains("light") &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          var next = dark ? "light" : "dark";
          root.classList.remove("light", "dark");
          root.classList.add(next);
          try {
            localStorage.setItem("theme-preference", next);
          } catch (err) {}
        });
      })();
    </script>
  </body>
</html>
